---
import Base from '~/layouts/Base.astro';
import { SITE, waLink } from '~/lib/site';

const services = [
  {
    code: '01',
    name: 'Facade ACP',
    desc: 'Fabrikasi & instalasi Aluminium Composite Panel — rangka hingga terpasang.',
  },
  {
    code: '02',
    name: 'Konstruksi Bangunan',
    desc: 'Pembangunan rumah & gedung dari nol sampai serah terima.',
  },
  {
    code: '03',
    name: 'Dapur Modular SPPG',
    desc: 'Sipil & perakitan dapur modular untuk program MBG pemerintah.',
  },
  {
    code: '04',
    name: 'Maintenance & Renovasi',
    desc: 'Perbaikan kebocoran, plafon, pembersihan ACP, dan renovasi bangunan.',
  },
];
---

<Base title={`${SITE.shortName} — ${SITE.tagline} | ${SITE.address.locality}, ${SITE.address.region}`}>
  <!-- Hero — v0.2 will bring the full PANEL treatment; this is the working skeleton -->
  <section class="border-b border-seam">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <p class="label-spec text-safety">Est. {SITE.foundingYear} — {SITE.address.locality}, {SITE.address.region}</p>
      <h1 class="display-panel mt-4 max-w-4xl text-4xl sm:text-6xl md:text-7xl">
        Spesialis Facade <span class="text-safety">ACP</span> & Kontraktor Bangunan
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-steel-600">
        Dari fasad bandara hingga cluster perumahan — SBS mengerjakan fabrikasi ACP, konstruksi, dan
        maintenance dengan tim sendiri, selesai sesuai spesifikasi.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={waLink('Halo SBS, saya ingin konsultasi proyek.')} class="btn-safety" target="_blank" rel="noopener">
          Konsultasi via WhatsApp
        </a>
        <a href="/proyek" class="btn-ghost">Lihat Proyek</a>
      </div>
    </div>
  </section>

  <!-- Services — panel grid -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <p class="label-spec">Layanan</p>
    <div class="mt-6 grid gap-px overflow-hidden rounded-panel border border-seam bg-seam sm:grid-cols-2">
      {
        services.map((s) => (
          <a href="/layanan" class="group bg-white p-6 transition-colors hover:bg-steel-50 md:p-8">
            <p class="font-mono text-xs text-safety">{s.code}</p>
            <h2 class="display-panel mt-3 text-xl md:text-2xl">{s.name}</h2>
            <p class="mt-3 text-sm leading-relaxed text-steel-600">{s.desc}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
